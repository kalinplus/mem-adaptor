{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mem-adaptor:schema:plan-report:0.1.0",
  "title": "Migration plan report",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/jcs_value"}],
  "required": ["schema_version", "canonical_model_version", "run_id", "created_at", "source", "source_inventory", "targets", "writers", "model_calls", "gate_policy", "entries", "source_unavailable", "anomalies", "warnings", "bundle_manifest", "digest_inputs", "plan_digest"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "canonical_model_version": {"const": "0.1.0"},
    "run_id": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/nonempty"},
    "created_at": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/timestamp"},
    "source": {"$ref": "#/$defs/source"},
    "source_inventory": {
      "type": "object", "additionalProperties": false, "required": ["files", "state"],
      "properties": {
        "files": {"type": "array", "items": {"$ref": "#/$defs/inventory_file"}},
        "state": {"enum": ["data_present", "empty"]}
      }
    },
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "writers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/writer"}},
    "model_calls": {"type": "array", "items": {"$ref": "#/$defs/model_call"}},
    "gate_policy": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/gate_policy"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "source_unavailable": {"type": "array", "items": {"$ref": "#/$defs/source_unavailable"}},
    "anomalies": {"type": "array", "items": {"$ref": "#/$defs/anomaly"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "bundle_manifest": {"$ref": "#/$defs/manifest"},
    "digest_inputs": {"$ref": "#/$defs/digest_inputs"},
    "plan_digest": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"},
    "previous_receipt_ref": {"type": "string", "minLength": 1},
    "shared_basis_ref": {"type": "string", "minLength": 1, "description": "Path of the receipt this plan reconciled shared products against (DEC-19 shared artifacts)."}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false, "required": ["location", "system", "export_version", "adapters"],
      "properties": {
        "location": {"type": "string", "minLength": 1},
        "system": {"type": "string", "minLength": 1},
        "export_version": {"type": "string", "minLength": 1},
        "adapters": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "version"],
            "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
          }
        },
        "satellite": {"$ref": "#/$defs/satellite"}
      }
    },
    "satellite": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/satellite_id"},
        "label": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/nonempty"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["id", "location", "writer", "artifacts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "writer": {"type": "string", "minLength": 1},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/target_artifact"}}
      }
    },
    "target_artifact": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
      },
      "oneOf": [
        {"required": ["content_hash", "bytes"]},
        {"not": {"anyOf": [{"required": ["content_hash"]}, {"required": ["bytes"]}]}}
      ]
    },
    "target_mapping": {
      "type": "object", "additionalProperties": false, "required": ["canonical_path", "target_path", "rule"],
      "properties": {
        "canonical_path": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"},
        "target_path": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "writer": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "capabilities"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "object", "additionalProperties": false,
          "required": ["supported_fields", "unsupported_fields", "read_back", "update"],
          "properties": {
            "supported_fields": {"type": "array", "items": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"}},
            "unsupported_fields": {"type": "array", "items": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"}},
            "read_back": {"type": "boolean"},
            "update": {"type": "boolean"}
          }
        }
      }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "content_hash", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
      }
    },
    "inventory_file": {
      "type": "object", "additionalProperties": false, "required": ["path", "content_hash", "bytes", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "status": {"enum": ["claimed", "unclaimed", "registered_only"]},
        "reader": {"type": "string", "minLength": 1},
        "layer": {"type": "string", "minLength": 1},
        "registered_count": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "deleted_count": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unclaimed"}}},
          "then": {"not": {"anyOf": [{"required": ["reader"]}, {"required": ["layer"]}, {"required": ["registered_count"]}]}},
          "else": {"required": ["reader", "layer"]}
        },
        {
          "if": {"properties": {"status": {"const": "registered_only"}}},
          "then": {"required": ["registered_count"]}
        }
      ]
    },
    "model_call": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "model", "count", "canonical_ids", "field_paths", "remote"],
      "properties": {
        "origin": {"enum": ["opt_in", "target_triggered"]},
        "model": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "canonical_ids": {"type": "array", "minItems": 1, "items": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/canonical_id"}},
        "field_paths": {"type": "array", "minItems": 1, "items": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"}},
        "remote": {"type": "boolean"}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false, "required": ["field_path", "kind"],
      "properties": {
        "field_path": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"},
        "kind": {"enum": ["reformatted", "field_omitted", "mapped", "referenced", "metadata_changed"]}
      }
    },
    "omission_reason": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["code", "canonical_id"],
          "properties": {
            "code": {"const": "duplicate_of"},
            "canonical_id": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/canonical_id"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["code"],
          "properties": {"code": {"enum": ["already_migrated", "deleted_in_target", "source_missing", "secret_reference_unsupported"]}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["code", "field"],
          "properties": {
            "code": {"const": "target_unsupported"},
            "field": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["code", "cluster_id"],
          "properties": {
            "code": {"const": "verdict_excluded"},
            "cluster_id": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"}
          }
        }
      ]
    },
    "unresolved_reason": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["code", "cluster_id"],
          "properties": {
            "code": {"const": "conflict"},
            "cluster_id": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["code", "field"],
          "properties": {
            "code": {"const": "dna_unsupported"},
            "field": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["code"],
          "properties": {"code": {"enum": ["memory_disabled", "deletion_needs_decision", "target_modified", "target_untracked"]}}
        }
      ]
    },
    "disposition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": {"status": {"const": "accepted"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status", "changes"],
          "properties": {
            "status": {"const": "transformed"},
            "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status", "reason"],
          "properties": {"status": {"const": "omitted"}, "reason": {"$ref": "#/$defs/omission_reason"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status", "reason"],
          "properties": {"status": {"const": "unresolved"}, "reason": {"$ref": "#/$defs/unresolved_reason"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status", "rule"],
          "properties": {"status": {"const": "rejected"}, "rule": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_id", "source_record_id", "source_locator", "content_hash", "target", "disposition", "field_map", "target_map", "unmapped", "sensitive_findings", "evidence_level"],
      "properties": {
        "canonical_id": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/canonical_id"},
        "source_record_id": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"},
        "target": {"type": "string", "minLength": 1},
        "disposition": {"$ref": "#/$defs/disposition"},
        "target_map": {"type": "array", "items": {"$ref": "#/$defs/target_mapping"}},
        "field_map": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["source_path", "canonical_path"],
            "properties": {
              "source_path": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"},
              "canonical_path": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"},
              "rule": {"type": "string", "minLength": 1}
            }
          }
        },
        "unmapped": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["source_path", "reason"],
            "properties": {
              "source_path": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"},
              "reason": {"enum": ["source_unknown", "engine_unreported", "target_unsupported", "registered_only"]}
            }
          }
        },
        "sensitive_findings": {"type": "array", "items": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/finding"}},
        "evidence_level": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/evidence_level"},
        "content_preview": {"type": "string", "description": "Display-only excerpt after masking findings; never a source snapshot."},
        "reembed_plan": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/reembed_plan"},
        "prior_write": {"$ref": "urn:mem-adaptor:schema:receipt-report:0.1.0#/$defs/prior_write"},
        "duplicate_write": {"$ref": "urn:mem-adaptor:schema:receipt-report:0.1.0#/$defs/duplicate_write"}
      }
    },
    "prediction": {
            "type": "object", "additionalProperties": false, "required": ["target", "disposition", "target_map"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "disposition": {"$ref": "#/$defs/disposition"},
              "target_map": {"type": "array", "items": {"$ref": "#/$defs/target_mapping"}},
        "prior_write": {"$ref": "urn:mem-adaptor:schema:receipt-report:0.1.0#/$defs/prior_write"},
        "duplicate_write": {"$ref": "urn:mem-adaptor:schema:receipt-report:0.1.0#/$defs/duplicate_write"}
      }
    },
    "digest_inputs": {
      "type": "object", "additionalProperties": false, "required": ["records", "targets", "writers", "gate_policy"],
      "properties": {
        "previous_receipt_hash": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash", "description": "Exact bytes of the complete loaded previous receipt, including carried history."},
        "shared_basis_hash": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash", "description": "Exact bytes of the shared-artifact basis receipt this plan reconciled against."},
        "records": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["canonical_id", "content_hash", "record_hash", "predictions"],
            "properties": {
              "canonical_id": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/canonical_id"},
              "content_hash": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"},
              "record_hash": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/hash"},
              "predictions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/prediction"}}
            }
          }
        },
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
        "writers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/writer"}},
        "gate_policy": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/gate_policy"}
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false, "required": ["source_system", "export_version", "files"],
      "properties": {
        "source_system": {"type": "string", "minLength": 1},
        "export_version": {"type": "string", "minLength": 1},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "exported_at": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/timestamp"}
      }
    },
    "anomaly": {
      "type": "object", "additionalProperties": false, "required": ["source_locator", "code"],
      "properties": {
        "source_locator": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "field_path": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/pointer"}
      }
    },
    "source_unavailable": {
      "type": "object", "additionalProperties": false, "required": ["system", "layer", "reason", "evidence_level"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "layer": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_level": {"$ref": "urn:mem-adaptor:schema:canonical-record:0.1.0#/$defs/evidence_level"}
      }
    }
  }
}
